<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="JSEARCH_FILTER"
			hint="COM_GENGEN_FILTER_SEARCH_DESC"
		/>

		<field
			name="published"
			type="status"
			label="JOPTION_SELECT_PUBLISHED"
			onchange="this.form.submit();"
		>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>

		<field
			name="target"
			type="GeneratorTarget"
			label="COM_GENGEN_FILTER_TARGET"
			addfieldprefix="Yepr\Component\Gengen\Administrator\Field"
			onchange="this.form.submit();"
		/>

		<!--
			Which language, since 4.5 - and the list shows the generators written
			for it *or for anything it derives from*, because a generator bound
			to a parent runs over a child's models.
		-->
		<field
			name="metalanguage"
			type="Metalanguage"
			label="COM_GENGEN_FILTER_METALANGUAGE"
			addfieldprefix="Yepr\Component\Gengen\Administrator\Field"
			onchange="this.form.submit();"
		/>
	</fields>

	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			default="a.name ASC"
			onchange="this.form.submit();"
			validate="options"
		>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.name ASC">COM_GENGEN_HEADING_NAME_ASC</option>
			<option value="a.name DESC">COM_GENGEN_HEADING_NAME_DESC</option>
			<option value="a.target ASC">COM_GENGEN_HEADING_TARGET_ASC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>

		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="20"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
