            "output": "administrator/components/com_{componentName|lower}/src/Ledger/AccountRoles.php",
            "condition": {
                "condition0": {
                    "operator": "has",
                    "path": "account_roles",
                    "value": ""
                }
            },
            "binding": {
                "binding0": {
                    "variable": "componentName",
                    "kind": "derive",
                    "value": "",
                    "derivation": "componentNameUcfirst",
                    "fragment_template": "",
                    "glue": ""
                },
                "binding1": {
                    "variable": "projectName",
                    "kind": "path",
