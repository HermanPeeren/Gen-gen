{
    "generator_name": "Joomla component with posting rules",
    "target": "joomla6",
    "output_path": "administrator/components/com_extengen/src/Generator",
    "php_namespace": "Yepr\\Component\\Extengen\\Administrator\\Generator",
    "extends": "joomla6",
    "group": {
        "group0": {
            "class": "AdminGeneral",
            "prefix": "admin.general.",
            "summary": "The files every component has: for LedgerLang, its account roles and posting rules too.",
            "emits": "1"
        }
    },
    "rule": {
        "rule0": {
            "rule_id": "admin.general.ledger.roles",
            "source": "root",
