includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # Level 5, the same as Exten-gen. There is no legacy tree here to hold it
    # down, so this can rise once the component's MVC lands at 2.4 and there is
    # something to raise it against.
    level: 5

    paths:
        - src/administrator/components/com_gengen/src
        - tests
        - tools

    # Joomla is reference material: it supplies the base classes the custom form
    # fields extend. Unpack a Joomla 6 package into /joomla, which is
    # git-ignored; CI fetches its own.
    #
    # Libraries only. A development machine's /joomla is usually a working site
    # with extensions installed in it, and scanning those means the analysis
    # resolves classes CI cannot see - which is not analysis, it is a local
    # accident. It masked two failures before this line was narrowed.
    scanDirectories:
        - joomla/libraries

    bootstrapFiles:
        - tools/phpstan-bootstrap.php

    excludePaths:
        # The shared library is installed into the development site as well as
        # required through composer, and the two are only the same version
        # until one of them is updated. Scanning both means analysing against
        # whichever copy the analyser happens to resolve first, which showed up
        # as "undefined constant Binding::KINDS" against a constant that very
        # much exists. Composer's copy is the one the tests run against, so it
        # is the one that counts.
        #
        # A glob, not the directory: PHPStan errors on an excludePath that does
        # not exist, and on CI it does not - a freshly fetched Joomla has no
        # extensions installed in it. A wildcard that matches nothing is fine.
        analyseAndScan:
            - joomla/libraries/yepr_gen/*

            # This one reaches into Exten-gen on purpose: it generates a
            # generator for that target and then runs it, which means naming
            # its classes. Exten-gen is not a dependency of this repository and
            # must not become one - Gen-gen models generators for whatever is
            # installed, and a composer requirement on one of them would be
            # exactly backwards.
            #
            # Unanalysed, then, and that is a real gap rather than a shrug. It
            # is covered another way: AcceptanceTest runs the script for real,
            # against a checked-out Exten-gen, and a name that did not resolve
            # would be a fatal error rather than a wrong answer.
            - tools/check-against-extengen.php

    treatPhpDocTypesAsCertain: false
